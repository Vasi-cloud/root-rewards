rules_version = '2';

/**
 * Forest Buddies Firestore security rules
 * Deploy: firebase deploy --only firestore:rules
 *
 * Clients may only manage their own user profile.
 * Role is locked to "customer" on create and cannot be changed by the client.
 * Products are public read; catalog writes allowed for soft-launch admin email
 * (see products match). Prefer Admin SDK for production writes when available.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function optionalNullableString(field, maxLen) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maxLen);
    }

    function requiredString(field, maxLen) {
      return field in request.resource.data
        && request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= maxLen;
    }

    function optionalIsoString(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= 40);
    }

    function userCreateKeysOk() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'role',
        'affiliateCode',
        'membershipTier',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'accountStatus',
        'deactivatedAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function userUpdateKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'email',
          'displayName',
          'photoURL',
          'affiliateCode',
          'membershipTier',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'accountStatus',
          'deactivatedAt',
          'updatedAt'
        ]);
    }

    function userFieldsValid() {
      return optionalNullableString('email', 320)
        && optionalNullableString('displayName', 120)
        && optionalNullableString('photoURL', 2048)
        && optionalNullableString('affiliateCode', 32)
        && optionalNullableString('membershipTier', 32)
        && optionalNullableString('stripeCustomerId', 64)
        && optionalNullableString('stripeSubscriptionId', 64)
        && optionalNullableString('accountStatus', 32)
        && optionalIsoString('deactivatedAt')
        && optionalIsoString('createdAt')
        && optionalIsoString('updatedAt');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // First profile: must be customer; cannot self-assign admin/seller
      allow create: if isOwner(userId)
        && userCreateKeysOk()
        && userFieldsValid()
        && requiredString('role', 32)
        && request.resource.data.role == 'customer'
        && requiredString('updatedAt', 40);

      // Updates: role is immutable from the client
      allow update: if isOwner(userId)
        && userUpdateKeysOk()
        && userFieldsValid()
        && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.role)
        && requiredString('updatedAt', 40);

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      // Soft-launch: allowlisted admin email may manage catalog from the client.
      // Prefer Admin SDK writes in production when available.
      allow create, update, delete: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'cvasi.crisan@gmail.com';
    }

    // Lea Valley Cycle Hire requests only — keyed to this shop, not other shops.
    match /shops/{shopId}/hireRequests/{requestId} {
      function isLeaValleyShop() {
        return shopId == 'demo-lea-valley-cycle-hire';
      }

      function hireRequestFieldsOk() {
        return request.resource.data.keys().hasOnly([
          'listingId',
          'listingTitle',
          'name',
          'email',
          'dates',
          'shopUid',
          'shopName',
          'createdAt',
          'status'
        ])
        && request.resource.data.shopUid == shopId
        && request.resource.data.status == 'new'
        && request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && request.resource.data.listingId.size() <= 80
        && request.resource.data.listingTitle is string
        && request.resource.data.listingTitle.size() > 0
        && request.resource.data.listingTitle.size() <= 200
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 160
        && request.resource.data.dates is string
        && request.resource.data.dates.size() > 0
        && request.resource.data.dates.size() <= 200
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() <= 120
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      }

      allow read: if isLeaValleyShop();
      allow create: if isLeaValleyShop() && hireRequestFieldsOk();
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
