rules_version = '2';

/**
 * Forest Buddies Firestore security rules
 * Deploy: firebase deploy --only firestore:rules
 *
 * Clients may only manage their own user profile.
 * Role is locked to "customer" on create and cannot be changed by the client.
 * Products are public read; catalog writes allowed for soft-launch admin email
 * (see products match). Prefer Admin SDK for production writes when available.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function optionalNullableString(field, maxLen) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= maxLen);
    }

    function requiredString(field, maxLen) {
      return field in request.resource.data
        && request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= maxLen;
    }

    function optionalIsoString(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= 40);
    }

    function userCreateKeysOk() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'role',
        'affiliateCode',
        'membershipTier',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'accountStatus',
        'deactivatedAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function userUpdateKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'email',
          'displayName',
          'photoURL',
          'affiliateCode',
          'membershipTier',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'accountStatus',
          'deactivatedAt',
          'updatedAt'
        ]);
    }

    function userFieldsValid() {
      return optionalNullableString('email', 320)
        && optionalNullableString('displayName', 120)
        && optionalNullableString('photoURL', 2048)
        && optionalNullableString('affiliateCode', 32)
        && optionalNullableString('membershipTier', 32)
        && optionalNullableString('stripeCustomerId', 64)
        && optionalNullableString('stripeSubscriptionId', 64)
        && optionalNullableString('accountStatus', 32)
        && optionalIsoString('deactivatedAt')
        && optionalIsoString('createdAt')
        && optionalIsoString('updatedAt');
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      // First profile: must be customer; cannot self-assign admin/seller
      allow create: if isOwner(userId)
        && userCreateKeysOk()
        && userFieldsValid()
        && requiredString('role', 32)
        && request.resource.data.role == 'customer'
        && requiredString('updatedAt', 40);

      // Updates: role is immutable from the client
      allow update: if isOwner(userId)
        && userUpdateKeysOk()
        && userFieldsValid()
        && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.role)
        && requiredString('updatedAt', 40);

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      // Soft-launch: allowlisted admin email may manage catalog from the client.
      // Prefer Admin SDK writes in production when available.
      allow create, update, delete: if isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'cvasi.crisan@gmail.com';
    }

    // Lea Valley Cycle Hire requests only — this shop’s hireRequests subcollection.
    match /shops/{shopId}/hireRequests/{requestId} {
      allow create: if shopId == 'demo-lea-valley-cycle-hire'
        && request.resource.data.shopUid == shopId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.dates is string
        && request.resource.data.dates.size() > 0
        && request.resource.data.listingTitle is string
        && request.resource.data.listingTitle.size() > 0;
      allow read: if shopId == 'demo-lea-valley-cycle-hire';
      allow update: if shopId == 'demo-lea-valley-cycle-hire'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'status', 'paidTotal', 'sellerShare', 'partnerPot'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seen'])
          || request.resource.data.seen == true
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['Confirmed', 'Declined', 'Paid']
        )
        && (
          isSignedIn()
          || (
            request.resource.data.status == 'Paid'
            && resource.data.status in ['Confirmed', 'Paid']
          )
        );
      allow delete: if false;
    }

    // One new Lea Valley hire listing. Not the five live bikes, not the marketplace.
    match /shops/{shopId}/hireListings/{listingId} {
      function isLiveHireId() {
        return listingId == 'demo-lv-pending-1'
          || listingId == 'demo-lv-pending-2'
          || listingId == 'lv-hub-half-day'
          || listingId == 'lv-hub-full-day'
          || listingId == 'lv-hub-weekend';
      }

      function isCatalogAdmin() {
        return isSignedIn()
          && request.auth.token.email != null
          && request.auth.token.email.lower() == 'cvasi.crisan@gmail.com';
      }

      allow read: if shopId == 'demo-lea-valley-cycle-hire';

      allow create: if shopId == 'demo-lea-valley-cycle-hire'
        && !isLiveHireId()
        && request.resource.data.keys().hasOnly([
          'name',
          'subtitle',
          'description',
          'price',
          'hirePeriod',
          'category',
          'status',
          'autoApproved',
          'listingType',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.price is number
        && request.resource.data.status == 'pending'
        && request.resource.data.autoApproved == false
        && request.resource.data.listingType == 'rental';

      allow update: if shopId == 'demo-lea-valley-cycle-hire'
        && isCatalogAdmin()
        && !isLiveHireId()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt'])
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'approved')
          || (resource.data.status == 'approved'
            && request.resource.data.status == 'rejected')
        );

      allow delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
